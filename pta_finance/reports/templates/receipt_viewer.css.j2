.receipt-item{font:inherit;font-weight:650;text-align:left;color:var(--deep);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
.receipt-item:hover{text-decoration-color:var(--sea)}
.receipt-hint{display:block;margin-top:4px;font-size:.68rem;font-weight:500;color:var(--ink-3)}
.receipt-item:focus-visible,.receipt-dialog button:focus-visible{outline:3px solid var(--sea);outline-offset:4px}
.receipt-dialog{margin:auto;padding:0;width:min(1100px,96vw);max-width:96vw;height:min(900px,94vh);max-height:94vh;border:1px solid var(--line);border-radius:10px;color:var(--ink);background:#f1f4f4;box-shadow:0 16px 70px #0006}
.receipt-dialog::backdrop{background:#102c38b8}
.receipt-dialog[open]{display:flex;flex-direction:column}
.receipt-head{display:flex;align-items:flex-start;gap:16px;padding:16px 20px;background:white;border-bottom:1px solid var(--line)}
.receipt-head>div{flex:1;min-width:0}.receipt-head h2{font-size:1.1rem;overflow-wrap:anywhere}.receipt-head p{font-size:.8rem;color:var(--ink-2);margin-top:5px}
.receipt-dialog button{font:inherit;font-size:.8rem;padding:7px 12px;border:1px solid var(--line);border-radius:5px;background:white;color:var(--deep);cursor:pointer}
.receipt-dialog button:hover:enabled{background:var(--wash)}.receipt-dialog button:disabled{opacity:.4;cursor:default}
.receipt-toolbar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:10px 20px;background:white;border-bottom:1px solid var(--line)}
.receipt-toolbar .receipt-page-label{flex:1;min-width:130px;font-size:.78rem;overflow-wrap:anywhere}
.receipt-status{padding:9px 20px;font-size:.8rem;color:var(--ink-2);background:#fff8eb;border-bottom:1px solid var(--line)}
.receipt-viewport{flex:1;min-height:0;overflow:auto;padding:22px;overscroll-behavior:contain}
.receipt-page{position:relative;margin:0 auto;background:white;box-shadow:0 2px 15px #0002}
.receipt-page img{display:block;width:100%;height:auto}.receipt-page svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.receipt-page ellipse{fill:none;stroke:#dc2626;stroke-width:3;vector-effect:non-scaling-stroke}
.receipt-empty{max-width:480px;margin:60px auto;padding:24px;border:1px solid var(--line);border-radius:8px;background:white;text-align:center}.receipt-empty h3{margin-bottom:8px}.receipt-empty p{font-size:.9rem;color:var(--ink-2)}
.receipt-dialog [hidden]{display:none!important}
@media(max-width:720px){.receipt-dialog{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;border:0;border-radius:0}.receipt-head{padding:12px}.receipt-toolbar{padding:8px 12px}.receipt-toolbar .receipt-page-label{flex-basis:100%;order:-1}.receipt-status{padding:8px 12px}.receipt-viewport{padding:12px}}
@media print{.receipt-dialog{display:none!important}.receipt-hint{display:none}.receipt-item{color:inherit;text-decoration:none}}
